# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามเครื่อง:  cp .env.example .env

# path ของ repo PTT_smart_ai_platform บนเครื่อง host (ที่เก็บ dataset + model จริงของ ปตท.)
# จะถูก bind mount เข้า container ที่ "path เดียวกัน" แบบอ่านอย่างเดียว
# ถ้าเครื่องนี้ไม่มี repo นี้ ให้คอมเมนต์ volume ข้อ (2) ใน docker-compose.yml ทิ้ง
PTT_PLATFORM_DIR=/home/luke/ai_training/PTT_smart_ai_platform

# พอร์ตบน host ที่จะใช้เปิด FiftyOne App (เว็บ) — เปลี่ยนได้ถ้าชนกับบริการอื่น
FIFTYONE_APP_PORT=5151
